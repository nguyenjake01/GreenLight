# Resume Verifier config (design doc §6.2). Copy to .env (never committed).
# Defaults are shown commented out; uncomment to override.

# VERIFIER_REAL=                      # comma list of modules to run real, or "all"; empty = all stubs
# RUNS_DIR=runs
GITHUB_TOKEN=
# GITHUB_FETCH_MODE=replay            # record / replay / live
# GITHUB_CACHE_DIR=fixtures/cache
# LLM_BASE_URL=https://inference.local/v1
# LLM_MODEL=Qwen3.6-35B-A3B-NVFP4
# LLM_NO_THINK_EXTRA={"chat_template_kwargs": {"enable_thinking": false}}
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
GREENHOUSE_WEBHOOK_SECRET=dev-secret
# HARVEST_AUTH_URL=http://localhost:8100/token
# HARVEST_BASE_URL=http://localhost:8100/v3
# HARVEST_CLIENT_ID=mock
# HARVEST_CLIENT_SECRET=mock
# NOTE_VISIBILITY=private             # public / private / admin_only
# VERIFIER_WEBHOOK_URL=http://localhost:8200/webhooks/greenhouse
# ATS_PUBLIC_URL=http://localhost:8100
INTERNAL_TOKEN=dev-token
# SANDBOX_BACKEND=openshell           # openshell / docker
# RUNCHECK_IMAGE=resume-verifier-runcheck:latest
# RUN_CHECK=on                        # on / baseline_only / off
# SLACK_ACTIONS=plugin                # plugin / agent / off
# CUT=                                # comma list: oss, generate, edit
# WRITEBACK_CAP_S=600
