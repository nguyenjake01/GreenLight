[{"sha":"4e000bfde0d70657d36fcc88b1ef19fee4512468","node_id":"C_kwDONFG6odoAKDRlMDAwYmZkZTBkNzA2NTdkMzZmY2M4OGIxZWYxOWZlZTQ1MTI0Njg","commit":{"author":{"name":"Henry Chen","email":"henrychen4736@berkeley.edu","date":"2026-09-15T05:04:49Z"},"committer":{"name":"Henry Chen","email":"henrychen4736@berkeley.edu","date":"2026-09-15T05:04:49Z"},"message":"Fix backend .gitignore hiding package data files\n\nThe unanchored \"data/\" rule meant for backend/data/ also matched\nbackend/src/tennis_ai/data/, so reference_default.json (the default\nreference ranges the service loads at startup) and data/__init__.py were\nnever committed, and a fresh clone could not start. Anchor the backend\nignore rules to the backend folder and add the two files.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01Vsv8y4nJBVp2YUVVtrg3yQ","tree":{"sha":"ee4de470c4d65a2676c3002c5a44cc977016c3d8","url":"https://api.github.com/repos/henrychen4736/CAC24/git/trees/ee4de470c4d65a2676c3002c5a44cc977016c3d8"},"url":"https://api.github.com/repos/henrychen4736/CAC24/git/commits/4e000bfde0d70657d36fcc88b1ef19fee4512468","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/henrychen4736/CAC24/commits/4e000bfde0d70657d36fcc88b1ef19fee4512468","html_url":"https://github.com/henrychen4736/CAC24/commit/4e000bfde0d70657d36fcc88b1ef19fee4512468","comments_url":"https://api.github.com/repos/henrychen4736/CAC24/commits/4e000bfde0d70657d36fcc88b1ef19fee4512468/comments","author":null,"committer":null,"parents":[{"sha":"35c7a4f32a3c9801cd16f94ac05cdaeae78bf68c","url":"https://api.github.com/repos/henrychen4736/CAC24/commits/35c7a4f32a3c9801cd16f94ac05cdaeae78bf68c","html_url":"https://github.com/henrychen4736/CAC24/commit/35c7a4f32a3c9801cd16f94ac05cdaeae78bf68c"}]},{"sha":"35c7a4f32a3c9801cd16f94ac05cdaeae78bf68c","node_id":"C_kwDONFG6odoAKDM1YzdhNGYzMmEzYzk4MDFjZDE2Zjk0YWMwNWNkYWVhZTc4YmY2OGM","commit":{"author":{"name":"Henry Chen","email":"henrychen4736@berkeley.edu","date":"2026-09-15T04:48:20Z"},"committer":{"name":"Henry Chen","email":"henrychen4736@berkeley.edu","date":"2026-09-15T04:48:20Z"},"message":"Add one-command setup script for any OS\n\n- bootstrap.py: checks for Python 3.11/3.12 and Flutter >= 3.47.3, creates\n  backend/.venv and installs the tennis_ai package (also repairs it after the\n  folder is moved), downloads the pose model, installs trained model files\n  (--models-from) or trains them (--train), runs flutter pub get\n- --run starts the server, picks a connected phone or cold-boots an emulator,\n  and launches the app (pointing a physical phone at the computer's LAN IP)\n- --test, --deploy-rules, --skip-frontend/--skip-backend, --device, --api-url\n- setup.sh (macOS/Linux) and setup.cmd/setup.ps1 (Windows) find Python and\n  run bootstrap.py\n- README: quick-start section and updated repository layout\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01Vsv8y4nJBVp2YUVVtrg3yQ","tree":{"sha":"8030fbb8d2d1b6a50a8dcf622730670425b4b10f","url":"https://api.github.com/repos/henrychen4736/CAC24/git/trees/8030fbb8d2d1b6a50a8dcf622730670425b4b10f"},"url":"https://api.github.com/repos/henrychen4736/CAC24/git/commits/35c7a4f32a3c9801cd16f94ac05cdaeae78bf68c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/henrychen4736/CAC24/commits/35c7a4f32a3c9801cd16f94ac05cdaeae78bf68c","html_url":"https://github.com/henrychen4736/CAC24/commit/35c7a4f32a3c9801cd16f94ac05cdaeae78bf68c","comments_url":"https://api.github.com/repos/henrychen4736/CAC24/commits/35c7a4f32a3c9801cd16f94ac05cdaeae78bf68c/comments","author":null,"committer":null,"parents":[{"sha":"21eb429a0421aeb1eba6eb69096f36bb5c430a77","url":"https://api.github.com/repos/henrychen4736/CAC24/commits/21eb429a0421aeb1eba6eb69096f36bb5c430a77","html_url":"https://github.com/henrychen4736/CAC24/commit/21eb429a0421aeb1eba6eb69096f36bb5c430a77"}]},{"sha":"21eb429a0421aeb1eba6eb69096f36bb5c430a77","node_id":"C_kwDONFG6odoAKDIxZWI0MjlhMDQyMWFlYjFlYmE2ZWI2OTA5NmYzNmJiNWM0MzBhNzc","commit":{"author":{"name":"Henry Chen","email":"henrychen4736@berkeley.edu","date":"2026-09-15T04:29:13Z"},"committer":{"name":"Henry Chen","email":"henrychen4736@berkeley.edu","date":"2026-09-15T04:29:13Z"},"message":"removed newbackend","tree":{"sha":"af4c541e9ce260f070d87bcf214923886e10cfc3","url":"https://api.github.com/repos/henrychen4736/CAC24/git/trees/af4c541e9ce260f070d87bcf214923886e10cfc3"},"url":"https://api.github.com/repos/henrychen4736/CAC24/git/commits/21eb429a0421aeb1eba6eb69096f36bb5c430a77","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/henrychen4736/CAC24/commits/21eb429a0421aeb1eba6eb69096f36bb5c430a77","html_url":"https://github.com/henrychen4736/CAC24/commit/21eb429a0421aeb1eba6eb69096f36bb5c430a77","comments_url":"https://api.github.com/repos/henrychen4736/CAC24/commits/21eb429a0421aeb1eba6eb69096f36bb5c430a77/comments","author":null,"committer":null,"parents":[{"sha":"81ab9dfbe2a754b21e4e2f2b7e60d6e01a08915f","url":"https://api.github.com/repos/henrychen4736/CAC24/commits/81ab9dfbe2a754b21e4e2f2b7e60d6e01a08915f","html_url":"https://github.com/henrychen4736/CAC24/commit/81ab9dfbe2a754b21e4e2f2b7e60d6e01a08915f"}]},{"sha":"81ab9dfbe2a754b21e4e2f2b7e60d6e01a08915f","node_id":"C_kwDONFG6odoAKDgxYWI5ZGZiZTJhNzU0YjIxZTRlMmYyYjdlNjBkNmUwMWEwODkxNWY","commit":{"author":{"name":"Henry Chen","email":"henrychen4736@berkeley.edu","date":"2026-09-15T04:26:19Z"},"committer":{"name":"Henry Chen","email":"henrychen4736@berkeley.edu","date":"2026-09-15T04:26:19Z"},"message":"Redesign the app and analysis service\n\nFrontend (Flutter 3.47, Material 3):\n- Rebuilt with Riverpod, go_router, and a typed dio API client\n- New flow: onboarding, auth, analyze (record/pick, stroke + hand options),\n  processing with progress, result screen with skeleton overlay, scores,\n  priorities, and per-phase metrics with range bars, history, profile\n- History saved to Firestore (per-user security rules), video and pose track\n  kept on device\n- Moved to Firebase project henry-tennis-q8mkn; iOS bundle ID com.henryTennis\n- Removed unused desktop/web platforms and Data Connect scaffolding\n\nBackend (new tennis_ai package, FastAPI):\n- MediaPipe Pose Landmarker (2D + 3D) with main-player tracking\n- Stroke detection, learned 9-class stroke classifier (ONNX) with heuristic\n  fallback, key-frame/phase detection, biomechanical metrics, rating against\n  default or expert-calibrated reference ranges, top priorities\n- Async job API (upload, poll, delete), optional Firebase auth\n- Training tools: THETIS download, pose extraction, feature building,\n  training with player-level validation, ONNX export, calibration\n- 37 pytest tests; Dockerfile\n\nDocs: detailed README and docs/ARCHITECTURE.md\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01Vsv8y4nJBVp2YUVVtrg3yQ","tree":{"sha":"8c55fa8fcb7c08ec9a1819afcc3308396dbb1c62","url":"https://api.github.com/repos/henrychen4736/CAC24/git/trees/8c55fa8fcb7c08ec9a1819afcc3308396dbb1c62"},"url":"https://api.github.com/repos/henrychen4736/CAC24/git/commits/81ab9dfbe2a754b21e4e2f2b7e60d6e01a08915f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/henrychen4736/CAC24/commits/81ab9dfbe2a754b21e4e2f2b7e60d6e01a08915f","html_url":"https://github.com/henrychen4736/CAC24/commit/81ab9dfbe2a754b21e4e2f2b7e60d6e01a08915f","comments_url":"https://api.github.com/repos/henrychen4736/CAC24/commits/81ab9dfbe2a754b21e4e2f2b7e60d6e01a08915f/comments","author":n